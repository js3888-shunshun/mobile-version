# ─── Mobile App Environment Variables ─────────────────────
#
# Copy this file to .env and adjust values for your setup.
#   cp .env.example .env
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the
# client-side JavaScript bundle.

# API server URL (change to your server's IP/hostname)
EXPO_PUBLIC_API_URL=http://172.105.135.182:4000

# Set to "false" to disable debug logging (enabled by default in __DEV__)
EXPO_PUBLIC_DEBUG=true
